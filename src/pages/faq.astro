---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";
import { faqs } from "../data/faqs";

/**
 * FAQ page — each Q&A doubles as a FAQPage schema entry (Google rich-result
 * accordion) AND long-tail SEO content (each question is a real search query).
 *
 * Maintenance rule: keep questions short + answers under ~110 words so Google
 * doesn't truncate the rich result.
 */



// FAQPage JSON-LD — Google parses this into a rich accordion in SERPs.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${site.url}/faq#faq`,
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};
---

<Layout
  title="FAQ — Video Compressor Questions Answered"
  description={`Answers about compressing video in your browser: is it free, does your video get uploaded, how to compress a video for WhatsApp, quality, supported formats, iPhone support, and file size limits. ${site.name}.`}
  path="/faq/"
  jsonLd={[faqSchema]}
>
  <Header />

  <main class="mx-auto max-w-[820px] px-4 sm:px-6 py-16 md:py-24">
    <p class="text-sm font-medium uppercase tracking-[0.08em] text-[var(--color-fg-subtle)]">FAQ</p>
    <h1 class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight">
      Frequently asked questions
    </h1>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
      Everything about how {site.name} works — what it does, what it doesn't do
      with your video (spoiler: never uploads it), and how to hit a specific size.
    </p>

    <hr class="my-12 border-[var(--color-border)]" />

    <div class="space-y-4">
      {faqs.map((f, i) => (
        <details
          class="group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 md:p-6 transition-colors hover:border-[var(--color-border-strong)]"
          open={i === 0}
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
            <h2 class="text-base md:text-lg font-semibold leading-snug text-[var(--color-fg)]">
              {f.q}
            </h2>
            <svg
              class="mt-1 size-5 shrink-0 text-[var(--color-fg-muted)] transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <p class="mt-4 leading-relaxed text-[var(--color-fg-muted)]">
            {f.a}
          </p>
        </details>
      ))}
    </div>

    <div class="mt-16 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 md:p-8">
      <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)]">
        Still have a question?
      </h2>
      <p class="mt-3 text-[var(--color-fg-muted)]">
        Read <a href="/how-it-works/" class="text-[var(--color-accent)] underline">how it works under the hood</a>,
        or just open the compressor — most things are clearer once you've shrunk
        one clip.
      </p>
      <a
        href="/app/"
        class="mt-6 inline-flex h-10 items-center rounded-md bg-[var(--color-accent)] px-5 text-sm font-semibold text-[var(--color-accent-fg)] transition-opacity hover:opacity-90"
      >
        Compress a video →
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Hide the default disclosure marker so our chevron is the only indicator. */
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary {
    list-style: none;
  }
</style>
